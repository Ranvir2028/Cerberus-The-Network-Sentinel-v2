# Cerberus v2 — frontend environment variables
#
# Copy this file to .env of frontend and fill in real values. .env is gitignored.
# Only used when running the frontend directly with `npm run dev`
# (Docker Compose sets these automatically from the root .env instead —
# see CERBERUS_PUBLIC_URL and CERBERUS_API_SECRET there).

# Address of the running Cerberus backend API.
VITE_API_BASE_URL=http://localhost:5000

# Must match CERBERUS_API_SECRET in the root .env. Leave blank if the
# backend is running with no API authentication configured.
VITE_API_KEY=
