# Cerberus v2 — environment variables
#
# Copy this file to .env and fill in real values. .env is gitignored —
# it never gets committed. This file (.env.example) is safe to commit.
#
# Everything here is optional unless noted. Cerberus runs fine with
# this file entirely blank — email alerts and the Trust/Block email
# links just won't work until the relevant variables are set.

# -----------------------------------------------------------------------
# API authentication
# -----------------------------------------------------------------------
# Secret key required on every /api/* request if set. Leave blank to run
# the API with no authentication (fine for local-only use, not recommended
# if the API is reachable from other devices on your network).
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CERBERUS_API_SECRET=

# -----------------------------------------------------------------------
# Email alerts (SMTP)
# -----------------------------------------------------------------------
# Set to true to enable email notifications when an untrusted device
# is detected. Requires the SMTP variables below to also be set.
CERBERUS_EMAIL_ALERTS=false

# Your email address (the account alerts are sent FROM)
CERBERUS_SMTP_SENDER=

# Gmail requires an "App Password", not your normal login password.
# Generate one at: Google Account → Security → 2-Step Verification → App Passwords
CERBERUS_SMTP_PASSWORD=

# Where alerts get sent TO. Comma-separate for multiple recipients.
CERBERUS_SMTP_RECIPIENTS=

# -----------------------------------------------------------------------
# Email Trust/Block links
# -----------------------------------------------------------------------
# Signs the "Trust this device" links embedded in alert emails so they
# can't be forged. If left blank, Cerberus still runs — it generates a
# random secret every startup instead, which means Trust links from a
# previous run stop working after a restart. Generate the same way as
# CERBERUS_API_SECRET above.
CERBERUS_LINK_SECRET=

# The address YOUR OWN devices can actually reach this machine at, used
# to build the Trust link in alert emails. api_host in config.json is
# usually "0.0.0.0", which is a bind address, not something you can open
# in a browser. Leave blank to default to http://localhost:5000, which
# only works if you open the link on the same machine Cerberus runs on.
# Set this to your machine's LAN IP to open Trust links from your phone.
CERBERUS_PUBLIC_URL=

# -----------------------------------------------------------------------
# Router credentials (optional, shown in alert emails only)
# -----------------------------------------------------------------------
# Displayed as plain text next to the "Block" link in alert emails so
# you can copy-paste them into your router's login page. Cerberus does
# NOT log in or block anything automatically — this only saves you a
# trip to go look up your own router credentials. Leave blank if you'd
# rather not have your router password sitting in your inbox.
CERBERUS_ROUTER_USER=
CERBERUS_ROUTER_PASSWORD=

# -----------------------------------------------------------------------
# Docker Compose only — frontend build-time variables
# -----------------------------------------------------------------------
# Port the frontend container is exposed on.
CERBERUS_FRONTEND_PORT=8080
