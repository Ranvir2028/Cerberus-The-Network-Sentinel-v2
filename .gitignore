# =============================================================
# CERBERUS v2 — .gitignore
# =============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# --- Virtual environments ---
venv/
.venv/
env/
.env/
ENV/

# --- Environment variables / secrets ---
.env
.env.*
!.env.example
config/email_config.json
config/config.json

# --- Cerberus runtime data (auto-generated, never commit) ---
data/devices.db
data/learning_mode.json
data/devices.db-shm
data/devices.db-wal
data/*.db
*.db
!data/oui.txt
logs/
*.log
known_devices.json

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Frontend (Node) ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env

# --- Docker ---
*.env.docker

# --- Misc ---
*.bak
*.tmp




# =============================================================
# FRONTEND STUFFS
# =============================================================

# --- Node / Package Managers ---
node_modules/
.pnpm-store/
.yarn/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# --- Build Outputs ---
dist/
build/
.next/
.nuxt/
out/
.output/

# --- Frontend Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local Environment Overrides ---
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Testing & Coverage (Frontend specific) ---
.jest/
coverage/
.vitest/
.cypress/

# --- Local Dependency Caches ---
.npm-cache-local.npm-cache-local/