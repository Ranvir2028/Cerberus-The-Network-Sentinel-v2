# =============================================================
# CERBERUS v2 — .gitignore
# =============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/

# --- Virtual environments ---
venv/
.venv/
env/
.env/
ENV/

# --- Environment variables / secrets ---
.env
.env.*
config/email_config.json

# --- Cerberus runtime data (auto-generated, never commit) ---
data/devices.db
data/*.db
logs/
*.log
known_devices.json

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Frontend (Node) ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env

# --- Docker ---
*.env.docker

# --- Misc ---
*.bak
*.tmp